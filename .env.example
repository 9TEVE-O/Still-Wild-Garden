
STILLWILD_DB_PATH=/data/stillwild.db
STILLWILD_TICK_SECONDS=300
STILLWILD_SSE_POLL_SECONDS=2
STILLWILD_AUTOMATION_AUTHORITY=false
STILLWILD_WORKER_ID=worker-1
STILLWILD_WILD_SIM=false
STILLWILD_WILD_SEED=7
STILLWILD_WILD_DAYS_PER_TICK=1
STILLWILD_CATCH_UP_LIMIT=6
# Generate distinct task/operator tokens of at least 32 characters. Empty disables API writes.
STILLWILD_TASK_TOKEN=
STILLWILD_OPERATOR_TOKEN=
# Optional sensor credential; use at least 32 characters and keep it distinct from both roles.
STILLWILD_SENSOR_TOKEN=
# Optional model-derived weather collection for a registered real garden.
STILLWILD_WEATHER_COLLECT=false
STILLWILD_REAL_GARDEN_ID=
STILLWILD_WEATHER_TIMEOUT_SECONDS=10
